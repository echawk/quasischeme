#lang racket/base
(require racket/fixnum racket/flonum)
(struct b (x y) #:transparent #:mutable)
(struct s () #:transparent)
(struct o (x))
(struct c (x y) #:prefab)
(define x (s))
(define (all v)
  (for ([pvl '(#f #t)])
    (parameterize ([print-vector-length pvl] [print-graph #t])
      (write v) (newline) (display v) (newline) (print v) (newline))))
(all (b 1 1))
(all (b 'struct:b 'struct:b))
(all (c 1 2))
(all (c x x))
(all (vector (b 1 1) 2 3 3 3))
(all (list 1 (b 1 2) 3))
(all (cons 1 (b 1 2)))
(all (list* 1 2 (b 1 2)))
(all (list x x))
(all (cons x x))
(all (list (list x)))
(all (box (b 1 2)))
(all (hash 1 (b 1 2)))
(all (mcons 1 2))
(all (list 'a (mcons 1 2) "s" #\c 2.5))
(all (list (o 1) 'a))
(all (fxvector 1 2 3 3 3))
(all (flvector 1.0 2.0 2.0))
(all (vector "a" "a" "a"))
(all (vector))
(all (list 'quote (b 1 2)))
(let ([v (b 1 2)]) (set-b-x! v v) (all v) (all (list v)))
