#lang racket/base
(define (try thunk) (with-handlers ([exn:fail? (lambda (e) (displayln (exn-message e)))]) (displayln (thunk))))
(try (lambda () (make-prefab-struct '(foo 2999999999999999) 1)))
(try (lambda () (make-prefab-struct '(foo 5 bar 2999999999999999) 1)))
(try (lambda () (make-prefab-struct '(foo 5 (1 #f) #(1) bar 2 #(99999)) 1 2 3 4 5 6 7 8)))
(try (lambda () (struct? (make-prefab-struct '(foo 5 (1 #f) #(1) bar 2 #()) 1 2 3 4 5 6 7 8))))
(try (lambda () (struct? (make-prefab-struct '(foo 5 (1 #f) #(1) bar 0 #()) 1 2 3 4 5 6))))
(try (lambda () (make-prefab-struct 'p 1 2)))
(try (lambda () (make-prefab-struct '(p 2) 1 2)))
(try (lambda () (make-prefab-struct '(p 1 q) 1 2 3)))
(try (lambda () (make-prefab-struct '(p 1 (q 1)) 1 2)))
(try (lambda () (make-prefab-struct '(p 3) 1 2)))
(try (lambda () (map prefab-key? (list 'a '(a 1) '(a #(0)) '(a 1 #(1)) #f "a" '(a 1 b 2) '(a -1)))))
(struct w (a b) #:prefab)
(struct v w (c) #:prefab #:mutable)
(struct u v (d) #:prefab)
(displayln (list (prefab-struct-key (v 1 2 3)) (prefab-struct-key (u 1 2 3 4))))
(displayln (list (v? (make-prefab-struct '(v #(0) w 2) 'one 'two 'three)) (u-d (make-prefab-struct (prefab-struct-key (u 1 2 3 4)) 1 2 3 4))))
