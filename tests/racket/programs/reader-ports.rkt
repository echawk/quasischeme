#lang racket/base
;; The reader and ports as Racket's: a cycle through a hash table, an
;; invalid UTF-8 sequence as one #� per byte, the current generator's
;; guard, struct-by-value FFI types only refused when called.
(define t (read (open-input-string "#0=#hash((\"apple\" . #0#))")))
(displayln (hash-count t))
(write t) (newline)
(define t2 (read (open-input-string "#0=#hasheq((#0# . 17))")))
(write t2) (newline)
(print (list t)) (newline)
(define s (bytes 244 144 128 128))
(define (go read-string)
  (let-values ([(in out) (make-pipe)])
    (for ([i 3]) (write-bytes s out))
    (close-output-port out)
    (let loop ([acc '()])
      (define v (read-string 3 in))
      (if (eof-object? v) (reverse acc) (loop (cons (map char->integer (string->list v)) acc))))))
(define (try name f) (printf "~a ~s\n" name (with-handlers ([exn? (lambda (e) (exn-message e))]) (go f))))
(try 'read read-string)
(try 'peek (lambda (n p) (let ([a (peek-string n 0 p)] [b (read-string n p)]) (if (equal? a b) a (list a b)))))
(try 'peek-off (let ([pos 0]) (lambda (n p) (begin0 (peek-string n pos p) (set! pos (+ (bytes-length s) pos))))))
(try 'chars (lambda (n p) (let loop ([i 0] [acc '()]) (if (= i n) (list->string (reverse acc)) (let ([c (read-char p)]) (if (eof-object? c) (if (null? acc) c (list->string (reverse acc))) (loop (add1 i) (cons c acc))))))))
(try 'peek-char (lambda (n p) (let loop ([i 0] [acc '()]) (if (= i n) (list->string (reverse acc)) (let ([a (peek-char p 0)] [c (read-char p)]) (if (eof-object? c) (if (null? acc) c (list->string (reverse acc))) (loop (add1 i) (cons c acc))))))))
(displayln (with-handlers ([exn:fail:contract? (lambda (e) 'refused)]) (current-pseudo-random-generator 10)))
(require ffi/unsafe)
(define-cstruct _pt ([x _int] [y _int]))
(define f (get-ffi-obj "abs" #f (_fun _pt -> _int)))
(displayln (procedure? f))
(for ([b (list (bytes 65 66) (bytes 244 144 128 128) (bytes 248 136 128 128 128) (bytes 237 160 128) (bytes 192 128) (bytes 65 255 66) (bytes 226 130) (bytes 226 130 172))])
  (printf "~s ~s ~s ~s\n" (bytes-utf-8-length b) (bytes-utf-8-length b #\?)
          (with-handlers ([exn? exn-message]) (bytes->string/utf-8 b))
          (bytes->string/utf-8 b #\?)))
