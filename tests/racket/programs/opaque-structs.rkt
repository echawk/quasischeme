#lang racket/base
(require racket/pretty)
(define-struct a (x y))
(displayln (struct? (a 1 2)))
(displayln (vector? (struct->vector (a 1 2))))
(pretty-write (a 1 2))
(pretty-print (a 1 2))
(parameterize ([current-inspector (make-inspector)])
  (define-struct d (x y))
  (displayln (struct? (d 1 2))))
(struct p1 (a))
(struct t1 p1 (b) #:transparent)
(struct t2 t1 (c))
(struct t3 t2 (d) #:transparent)
(displayln (struct->vector (t3 1 2 3 4)))
(displayln (struct->vector (a 1 2) 'x))
(write (t3 1 2 3 4)) (newline)
(print (t3 1 2 3 4)) (newline)
(print (list 1 (t1 1 2))) (newline)
(print (a 1 2) (current-output-port) 1) (newline)
(print '(1 x) (current-output-port) 1) (newline)
(displayln (struct? (t2 1 2 3)))
